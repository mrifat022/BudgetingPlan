rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isOwner(householdId) {
      return isMember(householdId)
        && get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function validAudit(householdId) {
      return request.resource.data.householdId == householdId
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validPeriodItem(householdId, periodId) {
      return validAudit(householdId)
        && request.resource.data.periodId == periodId;
    }

    function periodOpen(householdId, periodId) {
      return get(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)).data.status == 'active';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(householdId);
      allow delete: if false;

      match /members/{userId} {
        allow read: if isMember(householdId);
        allow create, update, delete: if isOwner(householdId);
      }

      match /activities/{activityId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.periodId is string
          && request.resource.data.action is string
          && request.resource.data.description is string;
        allow update, delete: if false;
      }

      match /incomeCategories/{categoryId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validAudit(householdId)
          && request.resource.data.name is string;
        allow delete: if false;
      }

      match /budgetCategories/{categoryId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validAudit(householdId)
          && request.resource.data.name is string;
        allow delete: if false;
      }

      match /fundSources/{sourceId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validAudit(householdId)
          && request.resource.data.name is string
          && request.resource.data.type in ['debit', 'credit_card', 'cash', 'other'];
        allow delete: if false;
      }

      match /debts/{debtId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validAudit(householdId);
        allow delete: if isMember(householdId);
      }

      match /receivables/{receivableId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validAudit(householdId);
        allow delete: if isMember(householdId);
      }

      match /periods/{periodId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && validAudit(householdId);
        allow update: if isMember(householdId)
          && validAudit(householdId)
          && (request.resource.data.status == resource.data.status
            || isOwner(householdId)
            || (resource.data.status == 'active' && request.resource.data.status == 'archived'));
        allow delete: if false;

        match /incomes/{incomeId} {
          allow read: if isMember(householdId);
          allow create, update: if isMember(householdId)
            && periodOpen(householdId, periodId)
            && validPeriodItem(householdId, periodId)
            && request.resource.data.amount is number
            && request.resource.data.amount > 0;
          allow delete: if isMember(householdId) && periodOpen(householdId, periodId);
        }

        match /budgets/{budgetId} {
          allow read: if isMember(householdId);
          allow create: if isMember(householdId)
            && periodOpen(householdId, periodId)
            && validPeriodItem(householdId, periodId)
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && (request.resource.data.realizedAmount == 0
              || (request.resource.data.realizationType == 'savings_allocation'
                && request.resource.data.fundSourceType == 'debit'
                && request.resource.data.cashAllocated == true
                && request.resource.data.realizedAmount == request.resource.data.amount)
              || ((budgetId == 'dana-darurat' || budgetId.matches('unexpected-credit-.*'))
                && request.resource.data.directUnexpected == true
                && request.resource.data.realizationType == 'transaction'
                && request.resource.data.fundSourceType in ['debit', 'credit_card']
                && request.resource.data.initialExpenseId is string
                && getAfter(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/expenses/$(request.resource.data.initialExpenseId)).data.budgetId == budgetId
                && getAfter(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/expenses/$(request.resource.data.initialExpenseId)).data.amount == request.resource.data.amount
                && request.resource.data.realizedAmount == request.resource.data.amount))
            && request.resource.data.realizationType in ['transaction', 'cash_allocation', 'savings_allocation'];
          allow update: if isMember(householdId)
            && periodOpen(householdId, periodId)
            && validPeriodItem(householdId, periodId)
            && request.resource.data.amount is number
            && request.resource.data.realizedAmount is number
            && request.resource.data.realizedAmount >= 0
            && request.resource.data.realizedAmount <= request.resource.data.amount
            && request.resource.data.realizationType in ['transaction', 'cash_allocation', 'savings_allocation'];
          allow delete: if isMember(householdId) && periodOpen(householdId, periodId) && resource.data.realizedAmount == 0;
        }

        match /creditLimits/{sourceId} {
          allow read: if isMember(householdId);
          allow create, update: if isMember(householdId)
            && periodOpen(householdId, periodId)
            && validPeriodItem(householdId, periodId)
            && request.resource.data.fundSourceId == sourceId
            && request.resource.data.amount is number
            && request.resource.data.amount > 0;
          allow delete: if false;
        }

        match /creditPayments/{paymentId} {
          allow read: if isMember(householdId);
          allow create: if isMember(householdId)
            && periodOpen(householdId, periodId)
            && validPeriodItem(householdId, periodId)
            && request.resource.data.fundSourceId is string
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.date is string;
          allow update: if false;
          allow delete: if isOwner(householdId)
            && periodOpen(householdId, periodId)
            && resource.data.fundSourceId is string
            && get(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/creditLimits/$(resource.data.fundSourceId)).data.availableAmount
              == get(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/creditLimits/$(resource.data.fundSourceId)).data.amount
            && getAfter(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/creditLimits/$(resource.data.fundSourceId)).data.availableAmount
              < get(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/creditLimits/$(resource.data.fundSourceId)).data.availableAmount;
        }

        match /expenses/{expenseId} {
          allow read: if isMember(householdId);
          allow create: if isMember(householdId)
            && periodOpen(householdId, periodId)
            && validPeriodItem(householdId, periodId)
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.budgetId is string
            && getAfter(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/budgets/$(request.resource.data.budgetId)).data.realizedAmount
              <= getAfter(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/budgets/$(request.resource.data.budgetId)).data.amount;
          allow update: if isMember(householdId)
            && periodOpen(householdId, periodId)
            && validPeriodItem(householdId, periodId)
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.categoryId == resource.data.categoryId
            && ((request.resource.data.budgetId == resource.data.budgetId
                && request.resource.data.fundSourceId == resource.data.fundSourceId)
              || (resource.data.budgetId == 'dana-darurat'
                && request.resource.data.budgetId.matches('unexpected-credit-.*')
                && request.resource.data.categoryId == 'dana-darurat'
                && request.resource.data.fundSourceType == 'credit_card'))
            && getAfter(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/budgets/$(request.resource.data.budgetId)).data.realizedAmount
              <= getAfter(/databases/$(database)/documents/households/$(householdId)/periods/$(periodId)/budgets/$(request.resource.data.budgetId)).data.amount;
          allow delete: if isMember(householdId) && periodOpen(householdId, periodId);
        }
      }
    }
  }
}
